# 本地私密配置模板
# 用法：复制本文件为 backend/application-local.yml，填入本机真实值。
# application-local.yml 已被 .gitignore 忽略，不会提交到仓库，也不会打包进 jar。

spring:
  datasource:
    # 本机 MySQL 连接信息
    url: jdbc:mysql://localhost:3306/activity_system?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    username: root
    password: 在这里填本机MySQL密码

activity:
  jwt:
    # 至少 32 字节的随机字符串，生产务必替换
    secret: 在这里填JWT密钥至少32字节
  checkin:
    qr-secret: 在这里填二维码HMAC密钥
    # 局域网/生产部署时改为实际可访问的前端地址，例如 http://192.168.1.10:5173
    public-base-url: http://localhost:5173

# 开发调试时可打开 SQL 日志：把下面这行取消注释
# mybatis-plus.configuration.log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
